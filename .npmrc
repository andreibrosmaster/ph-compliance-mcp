# pnpm settings — enterprise reproducibility.
# Strict peer-dependency resolution catches API-drift early (SDK/zod move fast).
strict-peer-dependencies=true
# Auto-install peers to keep installs working without manual --ignore flags.
auto-install-peers=true
# Lifecycle scripts run only for allowlisted packages (pnpm 10 gates scripts
# behind pnpm.onlyBuiltDependencies in package.json): better-sqlite3 fetches a
# prebuilt binary via its postinstall, esbuild needs its platform binary.
# Supply-chain hygiene comes from pnpm's default integrity verification +
# `pnpm audit --prod` in CI (which fails on high/critical), NOT from disabling
# scripts wholesale.
ignore-scripts=false
# Fail loudly on engine mismatches (Node >= 24).
engine-strict=true
